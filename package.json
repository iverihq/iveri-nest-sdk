{
  "name": "@iveri/nest-sdk",
  "version": "0.26.0",
  "description": "Shared NestJS plumbing for Iveri services — request context, auth guards, envelope encryption, typed exceptions, tenant-scoped persistence, config validation, health, Redis, rate limiting, metrics and error reporting",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iverihq/iveri-nest-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "default": "./dist/e2e/index.js"
    },
    "./service-token": {
      "types": "./dist/service-token/index.d.ts",
      "default": "./dist/service-token/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/verify-entry-points.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@iveri/prettier-config",
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@iveri/contracts": ">=0.16.0 <1.0.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "@prometheus-io/client": "^0.16.0",
    "@sentry/node": "^11.0.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@testcontainers/redis": "^12.0.0",
    "axios": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^1.1.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@nestjs/axios": {
      "optional": true
    },
    "@testcontainers/postgresql": {
      "optional": true
    },
    "@testcontainers/redis": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@iveri/contracts": "^0.39.0",
    "@iveri/eslint-config": "^0.2.3",
    "@iveri/prettier-config": "^0.1.0",
    "@iveri/tsconfig": "^0.2.1",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/testing": "^12.4.0",
    "@nestjs/typeorm": "^12.0.3",
    "@prometheus-io/client": "^0.16.1",
    "@sentry/node": "^11.11.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eslint": "^10.14.0",
    "ioredis": "^6.0.0",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.4",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
